# ============================================================================
# house_kgz backend — пример переменных окружения.
# Скопируйте в .env (`cp .env.example .env`) и подставьте свои значения.
# .env в git не попадает (см. .gitignore).
# ============================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Модуль настроек: config.settings.local | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.local
# Секретный ключ. Для прода сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
# Режим отладки. В production всегда false.
DJANGO_DEBUG=true
# Список хостов через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Часовой пояс проекта.
DJANGO_TIME_ZONE=Asia/Bishkek
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# DSN базы. Внутри docker-compose хост — имя сервиса `db`.
DATABASE_URL=postgres://house_kgz:house_kgz@db:5432/house_kgz
# Время жизни соединения в секундах (0 — закрывать после каждого запроса).
DATABASE_CONN_MAX_AGE=60
# Используются контейнером postgres при первичной инициализации.
POSTGRES_DB=house_kgz
POSTGRES_USER=house_kgz
POSTGRES_PASSWORD=house_kgz

# ---------------------------------------------------------------------------
# Redis (кэш + брокер Celery)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Лимит времени выполнения задачи, сек.
CELERY_TASK_TIME_LIMIT=300
# true — задачи выполняются синхронно в том же процессе (только для отладки).
CELERY_TASK_ALWAYS_EAGER=false

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Ключ подписи токенов. Если пусто — используется DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
# Время жизни access-токена, минуты.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
# Время жизни refresh-токена, дни.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ---------------------------------------------------------------------------
# Вход по SMS-коду (OTP)
# ---------------------------------------------------------------------------
# Сколько секунд живёт код.
OTP_CODE_TTL_SECONDS=300
# Через сколько секунд клиент может запросить следующий код.
OTP_RESEND_AFTER_SECONDS=60
# Сколько неудачных попыток допускается, прежде чем код сгорит.
OTP_MAX_ATTEMPTS=5
# Номера, для которых код всегда равен OTP_DEBUG_CODE и SMS не отправляется
# (ревью в сторах, автотесты). В DEBUG так работают все номера.
OTP_TEST_PHONES=+996700000001,+996700000002
OTP_DEBUG_CODE=0000
# Через сколько дней ночная задача удаляет старые коды.
OTP_RETENTION_DAYS=7
# Шаблон SMS; {code} подставляется кодом.
OTP_SMS_TEMPLATE=house_kgz: код {code}
# Лимиты запроса кода: <число>/<период> (second, minute, hour, day).
OTP_PHONE_RESEND_THROTTLE=1/min
OTP_PHONE_HOURLY_THROTTLE=5/hour
OTP_IP_THROTTLE=20/hour
# Лимиты входа по паролю (исполнители).
PASSWORD_LOGIN_PHONE_THROTTLE=10/hour
PASSWORD_LOGIN_IP_THROTTLE=30/hour

# ---------------------------------------------------------------------------
# SMS-провайдер
# ---------------------------------------------------------------------------
# console — писать SMS в лог (разработка); http — слать на HTTP-шлюз оператора.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_TOKEN=
# Таймаут запроса к шлюзу, секунды.
SMS_TIMEOUT=10
# Сколько раз повторить при сетевой ошибке (итого попыток = SMS_RETRIES + 1).
SMS_RETRIES=2
# База экспоненциальной задержки между попытками, секунды: 1, 2, 4…
SMS_RETRY_BACKOFF=1.0

# ---------------------------------------------------------------------------
# Каталог
# ---------------------------------------------------------------------------
# Курс USD/KGS, пока задача НБКР ни разу не отработала.
FALLBACK_USD_KGS_RATE=87.5
# Источник курсов валют (XML НБКР) и таймаут запроса.
NBKR_RATES_URL=https://www.nbkr.kg/XML/daily.xml
NBKR_TIMEOUT=10

# Сколько дней хранится история просмотров.
VIEW_HISTORY_RETENTION_DAYS=90

# Границы ползунка цены в фильтре, когда активных объявлений ещё нет, USD.
CATALOG_DEFAULT_PRICE_MIN=30000
CATALOG_DEFAULT_PRICE_MAX=350000

# ---------------------------------------------------------------------------
# Push-уведомления (Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# Путь к service-account JSON…
FCM_CREDENTIALS_FILE=
# …или его содержимое в base64 (удобно для CI и секретов Kubernetes).
# Если не задано ни то, ни другое — push выключен, уведомления в базе остаются.
FCM_CREDENTIALS_BASE64=

# ---------------------------------------------------------------------------
# Верификация личности (KYC)
# ---------------------------------------------------------------------------
# Максимальный размер файла документа, байты (по умолчанию 10 МБ).
KYC_MAX_FILE_SIZE=10485760
# Минимальное разрешение снимка.
KYC_MIN_WIDTH=800
KYC_MIN_HEIGHT=600
KYC_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/heic
# Срок жизни подписанной ссылки на документ, секунды.
KYC_SIGNED_URL_TTL=600
# Через сколько дней после решения фоновая задача удаляет сами файлы.
KYC_PURGE_AFTER_DAYS=30
# Лимит подач документов: <число>/<период>.
KYC_SUBMIT_THROTTLE=3/day

# ---------------------------------------------------------------------------
# Почта и поддержка
# ---------------------------------------------------------------------------
# В local по умолчанию письма печатаются в консоль (см. config/settings/local.py).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
# Адрес отправителя системных писем.
DEFAULT_FROM_EMAIL=noreply@house.kg
# Кому уходят письма о новых обращениях в поддержку (через запятую).
# Если пусто — письма уйдут на адреса из ADMINS, а при их отсутствии в лог.
SUPPORT_NOTIFY_EMAILS=support@house.kg
# Лимит обращений в поддержку: <число>/<период> (second, minute, hour, day).
SUPPORT_TICKET_THROTTLE=5/hour

# ---------------------------------------------------------------------------
# CORS / CSRF (важно для production)
# ---------------------------------------------------------------------------
# Разрешённые Origin через запятую. В local разрешено всё.
CORS_ALLOWED_ORIGINS=https://house.kg,https://app.house.kg
# Доверенные Origin для CSRF (админка, формы).
CSRF_TRUSTED_ORIGINS=https://house.kg,https://app.house.kg

# ---------------------------------------------------------------------------
# Безопасность (production)
# ---------------------------------------------------------------------------
# Редирект http -> https.
SECURE_SSL_REDIRECT=true
# HSTS, секунды (31536000 = 1 год). 0 — выключить.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ---------------------------------------------------------------------------
# S3-совместимое хранилище (MinIO локально, S3 в проде)
# ---------------------------------------------------------------------------
# true — медиа уезжают в S3/MinIO, false — лежат в MEDIA_ROOT.
USE_S3=false
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=house-kgz-media
AWS_S3_REGION_NAME=us-east-1
# Внутренний адрес MinIO в docker-сети. Для реального S3 оставьте пустым.
AWS_S3_ENDPOINT_URL=http://minio:9000
# Публичный домен раздачи файлов (CDN). Пусто — ссылки на endpoint.
AWS_S3_CUSTOM_DOMAIN=
# false — ссылки без подписи (публичный бакет).
AWS_QUERYSTRING_AUTH=false
# ОТДЕЛЬНЫЙ приватный бакет для документов верификации (KYC).
# Складывать их в бакет медиа объявлений нельзя даже в отдельную папку:
# у бакетов разные политики доступа (здесь — block-public-access).
AWS_PRIVATE_STORAGE_BUCKET_NAME=house-kgz-kyc
# Локально (USE_S3=false) приватные файлы лежат здесь — вне MEDIA_ROOT.
PRIVATE_MEDIA_ROOT=./private-media
# Используются контейнером MinIO.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
